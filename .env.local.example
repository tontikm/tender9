# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used only in API routes (app/api/*), never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret so only Vercel Cron (or you, manually) can trigger ingestion.
# Generate any random string, e.g. `openssl rand -hex 16`
CRON_SECRET=change-me-to-a-random-string
